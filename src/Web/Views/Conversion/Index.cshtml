@model MarkItDownWeb.Web.Models.ConversionViewModel
@{
    ViewData["Title"] = "Convertir archivos a Markdown";
}

<div class="conversion-shell">
    <header class="page-heading mb-4">
        <p class="eyebrow mb-2">CONVERSIÓN LOCAL</p>
        <h1>Convierte tus documentos a Markdown</h1>
        <p class="text-muted mb-0">Sube un archivo, revisa el resultado y descarga tu <code>.md</code>.</p>
    </header>

    <div class="row g-4">
        <section class="col-lg-8" aria-label="Conversor">
            <div class="card app-card p-4 mb-4">
                <label for="fileInput" class="form-label fw-semibold">Documento</label>
                <input type="file" id="fileInput" class="form-control"
                       accept=".pdf,.docx,.pptx,.xlsx,.html,.csv"
                       aria-describedby="supportedFormats statusText" />
                <div id="supportedFormats" class="form-text">PDF, Word, PowerPoint, Excel, HTML o CSV · máximo 100 MB</div>
                <div class="d-flex align-items-center gap-3 mt-3">
                    <button id="btnConvert" class="btn btn-primary px-4">Convertir a Markdown</button>
                    <span id="statusText" class="status-text text-muted" role="status" aria-live="polite"></span>
                </div>
            </div>

            <div class="card app-card p-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <div>
                        <p class="eyebrow mb-1">RESULTADO</p>
                        <h2 id="resultHeading" class="h5 mb-0">Markdown generado</h2>
                    </div>
                    <div class="d-flex gap-2">
                        <button id="btnCopy" class="btn btn-sm btn-outline-secondary" disabled>Copiar</button>
                        <button id="btnDownload" class="btn btn-sm btn-outline-primary" disabled>Descargar .md</button>
                        <button id="btnClear" class="btn btn-sm btn-outline-secondary">Limpiar</button>
                    </div>
                </div>
                <pre id="markdownOutput" class="markdown-output" aria-label="Contenido Markdown" tabindex="0"></pre>
            </div>
        </section>

        <aside class="col-lg-4" aria-label="Historial de conversiones">
            <div class="card app-card p-4">
                <div class="mb-3">
                    <p class="eyebrow mb-1">EN ESTE DISPOSITIVO</p>
                    <h2 class="h5 mb-0">Historial</h2>
                </div>
                <label class="visually-hidden" for="searchHistory">Buscar en el historial</label>
                <input type="search" id="searchHistory" class="form-control mb-3" placeholder="Buscar archivo..." />
                <ul id="historyList" class="list-group list-group-flush history-list"></ul>
                <p id="historyEmpty" class="text-muted small mt-3 mb-0" hidden>Aún no hay conversiones guardadas.</p>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="~/js/conversion.js" asp-append-version="true"></script>
}
